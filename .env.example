SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=cole_aqui_a_chave_publica_supabase
API_PORT=3333
WEB_ORIGIN=http://localhost:5173

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole_aqui_a_chave_publica_supabase
VITE_API_BASE_URL=/api
VITE_VAPID_PUBLIC_KEY=cole_aqui_a_chave_publica_vapid

# Supabase Edge Function secrets for push reminders.
# Set these in Supabase Function Secrets, never in frontend code.
SUPABASE_SERVICE_ROLE_KEY=cole_aqui_a_service_role_key
VAPID_PUBLIC_KEY=cole_aqui_a_chave_publica_vapid
VAPID_PRIVATE_KEY=cole_aqui_a_chave_privada_vapid
VAPID_SUBJECT=mailto:seu-email@exemplo.com
CRON_SECRET=gere_um_segredo_longo_para_o_cron
WEB_APP_URL=https://murilocsn.github.io/app-plantoes/
REMINDER_WINDOW_MINUTES=10

# Backend only: opt-in HTTP metrics. No traces or remote logs.
# npm API scripts run in apps/api; use DOTENV_CONFIG_PATH for another local env file.
# Never prefix these variables with VITE_ or commit real exporter credentials.
OTEL_SDK_DISABLED=true
OTEL_METRICS_EXPORTER=otlp
OTEL_SERVICE_NAME=financplantoes-api
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_METRIC_EXPORT_INTERVAL=60000
OTEL_EXPORTER_OTLP_TIMEOUT=5000
# Optional metrics-specific overrides (endpoint must include /v1/metrics):
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# OTEL_EXPORTER_OTLP_METRICS_TIMEOUT=5000
# Grafana Cloud: use the stack OTLP HTTPS endpoint and store its authorization
# header only in backend hosting secrets. See docs/11-operacao/opentelemetry.md.
